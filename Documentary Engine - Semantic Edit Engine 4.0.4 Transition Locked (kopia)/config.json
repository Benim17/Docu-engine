{
  "input_video": "input/build/GENERATED_sample_project.mp4",
  "captions_json": "output/captions.json",
  "captions_srt": "output/captions.srt",
  "style": "styles/tiktok_shorts.json",
  "output_video": "output/documentary.mp4",
  "language": "english",
  "model": "mlx-community/whisper-large-v3-turbo",
  "max_words_per_caption": 5,
  "min_words_per_caption": 2,
  "max_caption_duration": 2.4,
  "max_gap_inside_caption": 0.55,
  "uppercase": true,
  "reuse_existing_captions": false,
  "caption_director": {
    "enabled": true,
    "plan_json": "output/caption_director_plan.json",
    "default_position": "bottom",
    "bottom_vertical_anchor": 0.72,
    "top_vertical_anchor": 0.18,
    "safe_margin": 0.08,
    "max_width": 0.82,
    "max_lines": 2,
    "max_characters_per_line": 24,
    "max_highlight_words": 2,
    "highlight_color": "#FFD54A",
    "allow_scene_reposition": true
  },
  "story_director": {
    "enabled": true,
    "plan_json": "output/story_director_plan.json"
  },
  "video_codec": "libx264",
  "crf": 19,
  "preset": "medium",
  "audio_codec": "aac",
  "audio_bitrate": "192k",
  "motion_engine": {
    "enabled": true,
    "mode": "subject_aware",
    "seed": 300,
    "analysis_interval": 0.25,
    "cut_threshold": 0.27,
    "min_scene_duration": 1.2,
    "reuse_analysis": false,
    "analysis_json": "output/motion_analysis.json",
    "plan_json": "output/motion_plan.json",
    "min_zoom": 1.015,
    "max_zoom": 1.105,
    "pan_strength": 0.72,
    "resample": "bicubic",
    "scene_continuity": true,
    "reverse_to_pull_above": 0.72,
    "reverse_to_push_below": 0.28,
    "new_scene_pan_start_blend": 0.25,
    "neutral_pan_on_cut": true,
    "cut_settle_fraction": 0.1,
    "smooth_transitions": true,
    "transition_duration": 0.65,
    "safe_focus_x_min": 0.2,
    "safe_focus_x_max": 0.8,
    "safe_focus_y_min": 0.18,
    "safe_focus_y_max": 0.76,
    "transition_standard": "Smooth Transition Standard 1.0",
    "transition_max_scene_fraction": 0.2,
    "transition_timeline_source": "semantic_edit_plan",
    "transition_fail_closed": true
  },
  "project_dir": "input/build/sample_project",
  "project_audio": "input/build/sample_project/voiceover nurse.wav",
  "semantic_edit_engine": {
    "enabled": true,
    "manifest": "image_manifest.json",
    "plan_json": "output/semantic_edit_plan.json",
    "image_intelligence_json": "output/image_intelligence_plan.json",
    "min_beat_duration": 4.5,
    "preferred_beat_duration": 7.5,
    "max_beat_duration": 12.5,
    "visual_lead_seconds": 0.0,
    "repeat_penalty": 3.5,
    "immediate_repeat_penalty": 25.0
  }
}
